# GitHub token (classic token with gist scope, or fine-grained token with gists write permission)
GIST_TOKEN=

# Target gist id. Upload happens only when both GIST_TOKEN and GIST_ID are provided.
GIST_ID=

# Upload options
GIST_FILENAME=result.csv
# Optional. If empty, default will be: CloudflareSpeedTest result [tp=<port>] YYYY-mm-dd HH:MM:SS UTC+8
GIST_DESCRIPTION=

# Result file path generated by cfst inside container
GIST_RESULT_FILE=result.csv

# Loop test option (hours). Empty = run once. Example: 1 means run every 1 hour.
CFST_LOOP_HOURS=

# Scan type: ipv4 (default), ipv6, both
SCAN_TYPE=ipv4

# Test port. Optional. Default is 443 for ipv4/both, 8443 for ipv6.
CFST_TP=

# Optional. GitHub API Endpoint. Useful for proxying or using self-hosted GitHub API mirrors in mainland China.
# Default: https://api.github.com
# GITHUB_API_URL=https://api.github.com

# Optional. Network Proxy. If you need to proxy your curl requests inside the container.
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890

