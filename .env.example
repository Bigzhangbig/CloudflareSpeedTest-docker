# GitHub token (classic token with gist scope, or fine-grained token with gists write permission)
GIST_TOKEN=

# Target gist id. Upload happens only when both GIST_TOKEN and GIST_ID are provided.
GIST_ID=

# Upload options
GIST_FILENAME=result.csv
# Optional. If empty, default will be: CloudflareSpeedTest result [tp=<port>] YYYY-mm-dd HH:MM:SS UTC+8
GIST_DESCRIPTION=

# Result file path generated by cfst inside container
GIST_RESULT_FILE=result.csv

# Loop test option (hours). Empty = run once. Example: 1 means run every 1 hour.
CFST_LOOP_HOURS=
